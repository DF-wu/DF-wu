---
import { profile } from '../data/profile';
import { apiCatalog, designVariants, impactSignals } from '../data/portfolio-content';

const metricWall = [
  { label: 'Public repositories', value: profile.stats.publicRepos },
  { label: 'Merged PRs', value: profile.stats.mergedPRs },
  { label: 'Publications', value: profile.stats.publications },
  { label: 'Home-lab services', value: profile.stats.homeLabServices },
  { label: 'CCTS LOC', value: profile.stats.cctsLoc },
  { label: 'PDAS LOC', value: profile.stats.pdasLoc },
];
---

<div class="observatory-shell">
  <nav class="observatory-nav" aria-label="Primary">
    <a href="#observatory-top">DF Wu Observatory</a>
    <div>
      <a href="#metrics">Metrics</a>
      <a href="#sources">Sources</a>
      <a href="#variants">Variants</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  <main id="observatory-top">
    <section class="observatory-hero" aria-labelledby="observatory-title">
      <div>
        <p class="observatory-kicker">Analytics lab / {profile.location}</p>
        <h1 id="observatory-title">A data room for backend and platform evidence.</h1>
        <p>{profile.tagline}</p>
      </div>
      <aside class="radar-card" aria-label="Evidence radar">
        <img src="https://github.com/DF-wu.png?size=320" alt="Portrait avatar of ChuFei Wu" width="320" height="320" loading="eager" />
        <div class="radar-chart" aria-label="Impact score chart">
          {impactSignals.map((signal) => (
            <span class={`tone-${signal.tone}`} style={`--score:${signal.value}%`}>{signal.label}</span>
          ))}
        </div>
      </aside>
    </section>

    <section class="observatory-section" id="metrics" aria-labelledby="metrics-title">
      <div class="observatory-head">
        <p class="observatory-kicker">Metric wall</p>
        <h2 id="metrics-title">Signals from research, public work, and operations.</h2>
      </div>
      <div class="metric-wall">
        {metricWall.map((metric) => (
          <article>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="observatory-section split" id="sources" aria-labelledby="sources-title">
      <div class="observatory-head sticky">
        <p class="observatory-kicker">Source ledger</p>
        <h2 id="sources-title">Every claim points back to evidence.</h2>
      </div>
      <div class="source-ledger">
        {profile.evidenceSources.map((source) => (
          <a href={source.url} target="_blank" rel="noopener">
            <span>{source.label}</span>
            <small>{source.url}</small>
          </a>
        ))}
        {apiCatalog.map((api) => (
          <a href={api.path}>
            <span>{api.label}</span>
            <small>{api.description}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="observatory-section" id="variants" aria-labelledby="variants-title">
      <div class="observatory-head">
        <p class="observatory-kicker">Ten branches</p>
        <h2 id="variants-title">The portfolio itself becomes a test matrix.</h2>
      </div>
      <div class="variant-grid">
        {designVariants.map((variant) => (
          <article>
            <span>{variant.key}</span>
            <h3>{variant.name}</h3>
            <p>{variant.thesis}</p>
            <small>{variant.branch}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="observatory-contact" id="contact">
      <h2>Need someone who can read the system, not only the code?</h2>
      <a href={profile.links.email}>{profile.links.emailAddress}</a>
    </section>
  </main>
</div>
