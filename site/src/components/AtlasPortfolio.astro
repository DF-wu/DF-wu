---
import { profile } from '../data/profile';

const metrics = [
  { value: profile.stats.ieeepapers, label: 'IEEE papers', note: 'APSEC 2022 · ICS 2020' },
  { value: 1, label: 'best paper award', note: 'TCSE 2022 · Best Chinese Paper' },
  { value: profile.stats.homeLabServices, label: 'services operated', note: 'storage · DNS · monitoring · media' },
  { value: profile.stats.externalPRs, label: 'external merged PRs', note: `${profile.stats.mergedPRs} merged PRs in total` },
];

const routes = [
  {
    tone: 'research',
    label: 'Research route',
    title: 'Contract testing for event-driven microservices.',
    body: 'CCTS connects Pact contracts, runtime event logs, RabbitMQ, MongoDB, and state-model assertions so execution paths can be checked instead of guessed.',
    proof: 'APSEC 2022 / TCSE Best Chinese Paper',
  },
  {
    tone: 'delivery',
    label: 'Delivery route',
    title: 'Personal-data authorization and payment platform at ITRI.',
    body: 'PDAS and the valuation/payment platform pushed work across logging, payment, blockchain, fintech integration, CI/CD, infrastructure, and AKS delivery.',
    proof: 'ITRI / PDAS-team / ICS 2020',
  },
  {
    tone: 'operations',
    label: 'Operations route',
    title: 'Running my own infrastructure.',
    body: 'A self-hosted home-lab of 30+ services: storage, DNS, monitoring, media, albums, and home automation, plus Dell server fan control through iDRAC.',
    proof: 'HomeLab / iDRAC / internal systems',
  },
  {
    tone: 'collaboration',
    label: 'Collaboration route',
    title: 'Pull requests to other people\'s projects.',
    body: 'Mostly integrations, webhook fixes, localization, and documentation corrections in public repositories.',
    proof: `${profile.stats.mergedPRs} merged PRs / ${profile.stats.externalPRs} external`,
  },
];

// Metro-style career map: four lines meet at the portrait interchange.
const mapLines = [
  {
    tone: 'research',
    path: 'M260 210 L180 130 H40',
    stations: [
      { x: 180, y: 130, label: 'SOSELab' },
      { x: 110, y: 130, label: 'CCTS' },
      { x: 40, y: 130, label: 'APSEC 22', terminal: true },
    ],
    labelDy: -20,
  },
  {
    tone: 'delivery',
    path: 'M260 210 L340 130 H480',
    stations: [
      { x: 340, y: 130, label: 'ITRI' },
      { x: 410, y: 130, label: 'PDAS' },
      { x: 480, y: 130, label: 'AKS', terminal: true },
    ],
    labelDy: -20,
  },
  {
    tone: 'operations',
    path: 'M260 210 L340 290 H480',
    stations: [
      { x: 340, y: 290, label: 'Docker' },
      { x: 410, y: 290, label: 'iDRAC' },
      { x: 480, y: 290, label: 'HomeLab', terminal: true },
    ],
    labelDy: 30,
  },
  {
    tone: 'collaboration',
    path: 'M260 210 L180 290 H40',
    stations: [
      { x: 180, y: 290, label: 'Flipper' },
      { x: 110, y: 290, label: 'lilac' },
      { x: 40, y: 290, label: `${profile.stats.externalPRs} PRs`, terminal: true },
    ],
    labelDy: 30,
  },
];

const [featuredProject, ...otherProjects] = profile.projects;
const [featuredPaper, ...otherPapers] = profile.publications;

const stackGroups = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks', items: profile.skills.frameworks },
  { label: 'Platform', items: profile.skills.infrastructure },
  { label: 'Data & messaging', items: profile.skills.data },
  { label: 'Practice', items: profile.skills.practices },
];

const splitStack = (stack: string) => stack.split(' · ');
---

<div class="atlas-shell">
  <nav class="atlas-nav" aria-label="Primary">
    <a class="atlas-brand" href="#top" aria-label="DF Wu home">
      <span class="brand-token">DF</span>
      <span class="brand-name">{profile.fullName}<small>{profile.nameZh}</small></span>
    </a>
    <div class="atlas-links">
      <a href="#systems">Projects</a>
      <a href="#experience">Experience</a>
      <a href="#research">Research</a>
      <a class="nav-cta" href="#contact">Contact</a>
    </div>
  </nav>

  <main id="top">
    <section class="atlas-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="status-pill"><span aria-hidden="true"></span>Open to backend &amp; platform roles</p>
        <h1 id="hero-title">
          <span class="hero-zh" lang="zh-Hant">{profile.nameZh}</span>
          {profile.fullName}
        </h1>
        <p class="hero-lede">
          Backend and platform engineer. I did my M.S. on contract testing for event-driven microservices,
          worked on ITRI's personal-data authorization platform, and run my own home-lab.
        </p>
        <div class="hero-actions" aria-label="Primary links">
          <a class="primary-action" href={profile.links.email}>Get in touch <span aria-hidden="true">→</span></a>
          <a href={profile.links.resume} target="_blank" rel="noopener">Resume</a>
          <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <dl class="hero-facts">
          <div><dt>Role</dt><dd>Backend &amp; Platform</dd></div>
          <div><dt>Based in</dt><dd>{profile.location}</dd></div>
          <div><dt>Education</dt><dd>M.S. CSE · NTOU</dd></div>
          <div><dt>Research</dt><dd>IEEE APSEC 2022</dd></div>
        </dl>
      </div>

      <figure class="hero-visual" aria-label="Career route map">
        <figcaption>
          <span>Career route map</span>
          <span>2012 → now</span>
        </figcaption>
        <svg class="route-map" viewBox="0 88 520 256" role="img" aria-labelledby="route-map-title">
          <title id="route-map-title">Four career lines — research, delivery, operations, collaboration — meeting at one engineer</title>
          <defs>
            <clipPath id="hub-clip"><circle cx="260" cy="210" r="56" /></clipPath>
          </defs>
          {mapLines.map((line) => (
            <g class={`map-line tone-${line.tone}`}>
              <path class="map-track" d={line.path} />
              <path class="map-flow" d={line.path} />
              {line.stations.map((station) => (
                <g class="map-station">
                  <circle cx={station.x} cy={station.y} r={station.terminal ? 9 : 7} class={station.terminal ? 'terminal' : undefined} />
                  <text x={station.x} y={station.y + line.labelDy} text-anchor="middle">{station.label}</text>
                </g>
              ))}
            </g>
          ))}
          <circle class="hub-ring" cx="260" cy="210" r="64" />
          <image
            href="https://github.com/DF-wu.png?size=240"
            x="204"
            y="154"
            width="112"
            height="112"
            clip-path="url(#hub-clip)"
            preserveAspectRatio="xMidYMid slice"
          />
        </svg>
        <ul class="map-legend" aria-label="Route legend">
          {routes.map((route) => (
            <li class={`tone-${route.tone}`}><span aria-hidden="true"></span>{route.label.replace(' route', '')}</li>
          ))}
        </ul>
      </figure>
    </section>

    <section class="metric-ribbon" aria-label="Profile metrics">
      {metrics.map((metric) => (
        <article data-reveal>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          <small>{metric.note}</small>
        </article>
      ))}
    </section>

    <section class="atlas-section thesis" aria-labelledby="thesis-title">
      <div class="section-head">
        <p class="kicker">About</p>
        <h2 id="thesis-title">About me</h2>
      </div>
      <div class="thesis-copy">
        {profile.about.map((text) => <p>{text}</p>)}
        <ul class="philosophy">
          {profile.philosophy.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="atlas-section" id="routes" aria-labelledby="routes-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Overview</p>
          <h2 id="routes-title">Four areas of work.</h2>
        </div>
        <p>Research, delivery work, home-lab operations, and open-source contributions. Details for each are further down the page.</p>
      </div>
      <div class="route-grid">
        {routes.map((route, index) => (
          <article class={`route-card tone-${route.tone}`} data-reveal>
            <span class="route-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="route-label">{route.label}</span>
            <h3>{route.title}</h3>
            <p>{route.body}</p>
            <strong>{route.proof}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-section" id="systems" aria-labelledby="systems-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Selected systems</p>
          <h2 id="systems-title">Projects</h2>
        </div>
        <p>My thesis system, a Discord bot, home-lab configuration, a server fan-control tool, and a maintained fork of an offline speech-to-text tool.</p>
      </div>
      <div class="project-grid">
        <a class="project-card featured" href={featuredProject.url} target="_blank" rel="noopener" data-reveal>
          <div class="project-top">
            <span class="project-index">01 · Thesis system</span>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </div>
          <h3>{featuredProject.name}</h3>
          <p>{featuredProject.description}</p>
          <div class="ccts-flow" aria-label="CCTS verification flow">
            <span>Pact contracts</span>
            <span>Event logs</span>
            <span>State model</span>
            <span>Test report</span>
          </div>
          <div class="chip-row">{splitStack(featuredProject.stack).map((item) => <span>{item}</span>)}</div>
          <strong>{featuredProject.highlight}</strong>
        </a>
        {otherProjects.map((project, index) => (
          <a class="project-card" href={project.url} target="_blank" rel="noopener" data-reveal>
            <div class="project-top">
              <span class="project-index">{String(index + 2).padStart(2, '0')}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <div class="chip-row">{splitStack(project.stack).map((item) => <span>{item}</span>)}</div>
            {project.highlight && <strong>{project.highlight}</strong>}
          </a>
        ))}
      </div>
    </section>

    <section class="atlas-section" id="experience" aria-labelledby="experience-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Experience</p>
          <h2 id="experience-title">Experience</h2>
        </div>
        <p>{profile.education.degree} · {profile.education.school} · {profile.education.graduated}. Advised by {profile.education.advisor} at SOSELab.</p>
      </div>
      <ol class="experience-list">
        {profile.experience.map((item) => (
          <li data-reveal>
            <time>{item.period}</time>
            <div>
              <h3>{item.role}</h3>
              <p class="experience-org">{item.org}</p>
              <p>{item.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="atlas-section" id="research" aria-labelledby="research-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Research trail · <a href={profile.lab.url} target="_blank" rel="noopener">SOSELab</a></p>
          <h2 id="research-title">Publications</h2>
        </div>
        <p>{profile.lab.description}</p>
      </div>
      <div class="research-grid">
        <a class="paper-feature" href={featuredPaper.url} target="_blank" rel="noopener" data-reveal>
          <span class="paper-badge">{featuredPaper.publisher} · {featuredPaper.year} · {featuredPaper.role}</span>
          <h3>{featuredPaper.title}</h3>
          <p>{featuredPaper.abstract}</p>
          <p class="paper-venue">{featuredPaper.venue}</p>
          <div class="award-line">
            <span aria-hidden="true">★</span>
            {profile.awards[0].title} — {profile.awards[0].context.split(' — ')[0]}
          </div>
        </a>
        <div class="paper-side">
          {otherPapers.map((paper) => (
            <a class="paper-row" href={paper.url} target="_blank" rel="noopener" data-reveal>
              <span>{paper.publisher} / {paper.year}</span>
              <h3>{paper.title}</h3>
              <p>{paper.venue} · {paper.role}</p>
            </a>
          ))}
          {profile.domesticPublications.map((paper) => (
            <article class="paper-row domestic" data-reveal>
              <span>{paper.venue}</span>
              <h3 lang="zh-Hant">{paper.title}</h3>
              <p>{paper.titleEn}</p>
              {paper.award && <strong>★ {paper.award}</strong>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="atlas-section" aria-labelledby="stack-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Tools</p>
          <h2 id="stack-title">Languages and tools I have used</h2>
        </div>
        <p>Collected from the projects, research, and jobs listed above.</p>
      </div>
      <div class="stack-matrix">
        {stackGroups.map((group) => (
          <article data-reveal>
            <h3>{group.label}</h3>
            <div>
              {group.items.map((item) => <span>{item}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-section" aria-labelledby="collab-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Open source</p>
          <h2 id="collab-title">Merged pull requests in other repositories</h2>
        </div>
        <p>A selection. Each entry links to the pull request.</p>
      </div>
      <div class="ledger">
        {profile.contributions.map((item) => (
          <a href={item.url} target="_blank" rel="noopener">
            <span>{item.type}</span>
            <strong>{item.description}</strong>
            <small>{item.repo} {item.pr} <span aria-hidden="true">↗</span></small>
          </a>
        ))}
      </div>
    </section>

    <section class="atlas-section role-fit" aria-labelledby="fit-title">
      <div class="section-head inline">
        <div>
          <p class="kicker">Role fit</p>
          <h2 id="fit-title">Roles that match my background</h2>
        </div>
      </div>
      <div class="fit-grid">
        {profile.roles.map((role) => (
          <article data-reveal>
            <h3>{role.title}</h3>
            <p>{role.why}</p>
            <span>{role.evidence}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="atlas-contact" id="contact" aria-labelledby="contact-title">
      <div>
        <p class="kicker">Contact</p>
        <h2 id="contact-title">Get in touch</h2>
        <p class="contact-motto">Email is the best way to reach me.</p>
      </div>
      <div class="contact-links">
        <a class="primary-action" href={profile.links.email}>{profile.links.emailAddress}</a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={profile.links.mastodon} target="_blank" rel="noopener">Mastodon</a>
        <a href={profile.links.resume} target="_blank" rel="noopener">Resume PDF</a>
      </div>
    </section>
  </main>

</div>
