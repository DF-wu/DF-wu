---
import { profile } from '../data/profile';
import type { StyleKey } from '../data/profile';
import { apiCatalog, designVariants, insightArticles } from '../data/portfolio-content';

interface Props {
  title: string;
  description?: string;
  stylesheets?: string[];
  currentStyle?: StyleKey;
}

const {
  title,
  description = 'DF Wu — backend and platform engineer building stable, maintainable systems.',
  stylesheets = [],
  currentStyle,
} = Astro.props;
const commandData = [
  ...profile.projects.map((item) => ({ type: 'Project', title: item.name, summary: item.description, url: item.url })),
  ...profile.publications.map((item) => ({ type: 'Publication', title: item.title, summary: item.abstract, url: item.url })),
  ...insightArticles.map((item) => ({ type: 'Insight', title: item.title, summary: item.summary, url: `#insight-${item.slug}` })),
  ...apiCatalog.map((item) => ({ type: 'API', title: item.label, summary: item.description, url: item.path })),
  ...designVariants.map((item) => ({ type: 'Style', title: item.name, summary: item.thesis, url: `/styles/${item.key}/` })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+TC:wght@400;500;700;900&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <script type="application/json" id="portfolio-command-data" set:html={JSON.stringify(commandData)} />
    <script defer src="/scripts/portfolio-effects.js"></script>
    <title>{title}</title>
  </head>
  <body data-portfolio-shell>
    <a class="skip-link" href="#portfolio-content">Skip to portfolio content</a>
    <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
    <div id="portfolio-content">
      <slot />
    </div>

    <div class="portfolio-dock" aria-label="Portfolio tools">
      <button type="button" data-tool="styles" aria-label="Switch design style" title="Styles">Style</button>
      <button type="button" data-tool="search" aria-label="Open command search" title="Search">Search</button>
      <button type="button" data-tool="api" aria-label="Open API console" title="API">API</button>
      <button type="button" data-tool="theme" aria-label="Toggle contrast mode" title="Contrast">Tone</button>
      <button type="button" data-tool="top" aria-label="Back to top" title="Top">Top</button>
    </div>

    <dialog class="portfolio-dialog styles-dialog" data-styles-dialog aria-label="Design style switcher">
      <form method="dialog" class="dialog-head">
        <strong>Switch design system</strong>
        <button type="submit" aria-label="Close style switcher">Close</button>
      </form>
      <div class="styles-list">
        {designVariants.map((variant, index) => (
          <a
            href={`/styles/${variant.key}/`}
            class="styles-list-item"
            aria-current={currentStyle === variant.key ? 'page' : undefined}
          >
            <span class="styles-list-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="styles-list-body">
              <strong>{variant.name}</strong>
              <small>{variant.thesis}</small>
            </span>
            {currentStyle === variant.key && <span class="styles-list-current">Current</span>}
          </a>
        ))}
        <a href="/styles/" class="styles-list-item styles-list-gallery">
          <span class="styles-list-index">☰</span>
          <span class="styles-list-body">
            <strong>Open the full gallery</strong>
            <small>Compare palettes, theses, and interaction effects side by side.</small>
          </span>
        </a>
      </div>
    </dialog>

    <dialog class="portfolio-dialog command-dialog" data-command-dialog aria-label="Portfolio command search">
      <form method="dialog" class="dialog-head">
        <strong>Search portfolio intelligence</strong>
        <button type="submit" aria-label="Close search">Close</button>
      </form>
      <label class="command-input">
        <span>Query</span>
        <input type="search" data-command-input placeholder="Search projects, papers, APIs, variants" autocomplete="off" />
      </label>
      <div class="command-results" data-command-results></div>
    </dialog>

    <dialog class="portfolio-dialog api-dialog" data-api-dialog aria-label="Portfolio API console">
      <form method="dialog" class="dialog-head">
        <strong>Portfolio API console</strong>
        <button type="submit" aria-label="Close API console">Close</button>
      </form>
      <div class="api-console-grid">
        <div class="api-list">
          {apiCatalog.map((api) => (
            <button type="button" data-api-endpoint={api.path}>
              <span>{api.label}</span>
              <small>{api.path}</small>
            </button>
          ))}
          <button type="button" data-live-github>Live GitHub profile</button>
        </div>
        <pre class="api-preview" data-api-preview>{JSON.stringify({ ready: true, hint: 'Choose an endpoint to preview JSON.' }, null, 2)}</pre>
      </div>
    </dialog>
  </body>
</html>
